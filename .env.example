APP_NAME="Bank Majalengka"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://bprmajalengka.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Konfigurasi Database Produksi (MySQL cPanel)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nama_database_cpanel
DB_USERNAME=user_database_cpanel
DB_PASSWORD=password_database_cpanel

# Alternatif Lokal (SQLite)
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ========================================================
# PENGATURAN EMAIL PENGADUAN & NOTIFIKASI NASABAH (SMTP)
# ========================================================
# Opsi Utama: Gmail SMTP via Port 465 (SSL - Sangat Direkomendasikan untuk cPanel Hosting)
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_USERNAME=kamelianisaaa@gmail.com
MAIL_PASSWORD="atepemdgxvdfhohp"
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS="kamelianisaaa@gmail.com"
MAIL_FROM_NAME="Layanan Nasabah Bank Majalengka"

# Opsi Alternatif: Gmail SMTP via Port 587 (TLS)
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=kamelianisaaa@gmail.com
# MAIL_PASSWORD="atepemdgxvdfhohp"
# MAIL_ENCRYPTION=tls
# MAIL_FROM_ADDRESS="kamelianisaaa@gmail.com"
# MAIL_FROM_NAME="Layanan Nasabah Bank Majalengka"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
